# api call for list assessments
###
GET http://127.0.0.1:8000/assessments/exam/
Accept: application/json
Authorization: Token d6426653f00333e8669f7c338633402dbf137446

# api call for create assessments
###
POST http://127.0.0.1:8000/assessments/exam/
Content-Type: application/json
Authorization: Token d6426653f00333e8669f7c338633402dbf137446

{
    "title":"Python Basics Quiz",
    "description":"A short quiz to test basic Python knowledge.",
    "instructions":"Complete all questions within the given time.",
    "duration":30
}

# api call for retrieve assessment
###
GET http://127.0.0.1:8000/assessments/exam/1/
Accept: application/json
Authorization: Token 340f51512140d7392f8e3df3e183b5848849c5a6

# api call for update assessment
###
PATCH http://127.0.0.1:8000/assessments/exam/1/
Content-Type: application/json
Authorization: Token 340f51512140d7392f8e3df3e183b5848849c5a6

{
    "duration":60
}

# api call for Admin publish an assessment
###
POST http://127.0.0.1:8000/assessments/exam/1/publish/
Content-Type: application/json
Authorization: Token 340f51512140d7392f8e3df3e183b5848849c5a6